# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key: ใช้ฝั่ง Nest เท่านั้น ห้ามหลุดไป client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=imports

# ---- Postgres ----
# ปุ่ม Connect ด้านบนของ Supabase Dashboard → Direct → Connection string
#   เครื่องตัวเอง : Session pooler     (port 5432)
#   Vercel       : Transaction pooler (port 6543) — ทางที่ Supabase แนะนำสำหรับ serverless
# โค้ดใช้ได้ทั้งสองแบบ (ไม่มี named prepared statement / advisory lock / LISTEN)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# connection ต่อ process — ไม่ตั้งจะได้ 10 บนเครื่องตัวเอง และ 3 บน Vercel
# PG_POOL_MAX=3

# ---- API ----
API_PORT=3001
# ปิดการตรวจ token ตอน dev — env.ts ปฏิเสธค่านี้ถ้า NODE_ENV=production
AUTH_DISABLED=false
# ต้นทางที่อนุญาตให้เรียก API — บน Vercel ใส่ URL ของโปรเจกต์เว็บ คั่นหลายค่าด้วย comma
CORS_ORIGIN=http://localhost:3000
# สุ่มยาว ๆ แล้วตั้งในโปรเจกต์ API บน Vercel — Vercel แนบให้เองตอนเรียก cron
# ไม่ตั้ง = endpoint cron ปิดตัวเอง (ปฏิเสธทุกคำขอ)
# CRON_SECRET=

# ---- Web (ต้องขึ้นต้น NEXT_PUBLIC_ ถึงจะถึง browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# บน Vercel ใส่ URL ของโปรเจกต์ API
NEXT_PUBLIC_API_URL=http://localhost:3001
# ปิดหน้าล็อกอินตอน dev (อีเมลในตัวของ Supabase จำกัด 2 ฉบับ/ชั่วโมง)
# ต้องตั้งให้ตรงกับ AUTH_DISABLED ข้างบนเสมอ ไม่งั้นเว็บเข้าได้แต่ API ตอบ 401
NEXT_PUBLIC_AUTH_DISABLED=false
