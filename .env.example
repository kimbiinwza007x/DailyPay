# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key: ใช้ฝั่ง Nest เท่านั้น ห้ามหลุดไป client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=imports

# ---- Postgres ----
# Project Settings → Database → Connection string (URI)
# ใช้ session pooler (port 5432) สำหรับ worker เพราะต้องใช้ transaction + advisory lock
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- API ----
API_PORT=3001
# ปิดการตรวจ token ตอน dev — env.ts ปฏิเสธค่านี้ถ้า NODE_ENV=production
AUTH_DISABLED=false
# ต้นทางที่อนุญาตให้เรียก API (Next dev server)
CORS_ORIGIN=http://localhost:3000

# ---- Web (ต้องขึ้นต้น NEXT_PUBLIC_ ถึงจะถึง browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_API_URL=http://localhost:3001
# ปิดหน้าล็อกอินตอน dev (อีเมลในตัวของ Supabase จำกัด 2 ฉบับ/ชั่วโมง)
# ต้องตั้งให้ตรงกับ AUTH_DISABLED ข้างบนเสมอ ไม่งั้นเว็บเข้าได้แต่ API ตอบ 401
NEXT_PUBLIC_AUTH_DISABLED=false
