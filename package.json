{
  "name": "dailypay",
  "private": true,
  "version": "0.1.0",
  "description": "ระบบบันทึกรายรับรายจ่ายอัตโนมัติ — Nest + Next + Supabase",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @dailypay/api dev",
    "dev:worker": "pnpm --filter @dailypay/api dev:worker",
    "dev:web": "pnpm --filter @dailypay/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @dailypay/api test",
    "lint": "pnpm -r lint",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
